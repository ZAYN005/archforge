{
  "name": "space-fractions",
  "version": "1.0.0",
  "private": true,
  "description": "Space Fractions - generated by ArchForge from the architecture spec",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "jest --runInBand",
    "dist": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  },
  "build": {
    "appId": "com.archforge.spacefractions",
    "productName": "Space Fractions",
    "files": [
      "electron/**",
      "public/**",
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    }
  }
}
